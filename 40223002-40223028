{
    printf("NO. FIRST NAME           LAST NAME            ID                   CITY\n");
    data* current = head;
    while (current != NULL)
    {
        printf("%-3d %-20s %-20s %-20s %-20s\n", current->row, current->firstName, current->lastName, current->ID, current->city);
        current = current->next;
    }

}


