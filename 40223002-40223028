// Function to delete a student
data* deletefunc(data*head,data *students[],int position)
{
    data * temp_del =  head;
    data * temp2 = NULL;
    if (position == 1) // deleting the first node
    {
        temp2 = temp_del -> next;
        temp2 -> prev = NULL;
        head = temp2;
    } else {
        for (int i=1 ; i < position ; i++)
        {
            temp_del = temp_del -> next;//temp_del points to where we want to delete
        }
        if (temp_del -> next == NULL) // deleting the last node
        {
            temp2 = temp_del -> prev;
            temp2-> next = NULL;
        }else{// deleting the node in the middle of linked list
        temp2 = temp_del -> prev; //temp2 points to prev of where we want to delete
        temp2 -> next = temp_del -> next;
        temp_del->next->prev = temp2;
        }
        
    }
    free (temp_del);

    // save the info in the array
    numStudents --;
    ListToArray(head,students);
    
    return head;
}


// Function random
data * random_changing(data *head, struct data *students[], int size)
{
    srand(time(NULL));
    
    for(int i = size - 1 ; i > 0 ; --i)
    {
        int j = rand() % (i + 1);
        //swapping
        struct data *temp = students[i];
        students[i] = students[j];
        students[j] = temp;
    }

    // saving the info of the array in the doubly linked list
    head = ArrayToList(head,students);
    return head;
}

