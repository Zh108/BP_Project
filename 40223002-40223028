// Function to write in the file
void writeToFile(data* head) {
    FILE* file2 = fopen("students.txt", "w");
    if (file2 == NULL) {
        printf("Error opening file.\n");
    }

    data* current = head;
    while (current != NULL) {
        fprintf(file2,"%-20s %-20s %-20s %-20s\n",current->firstName, current->lastName, current->ID, current->city);
        current = current->next;
    }

    fclose(file2);

    FILE* file3 = fopen("output.bin", "wb");
    if (file3 == NULL) {
        printf("Error opening file.\n");
    }

    data* current2 = head;
    while (current2 != NULL) {
        fprintf(file3,"%-20s %-20s %-20s %-20s\n",current2->firstName, current2->lastName, current2->ID, current2->city);
        current2 = current2->next;
    }

    fclose(file3);
}


