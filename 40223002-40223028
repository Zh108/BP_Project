// text and rect
void get_text_and_rect(SDL_Renderer *renderer,
    int x, int y,
    char *text, TTF_Font *font,
    SDL_Texture **texture, SDL_Rect *rect)
{
    int text_width;
    int text_height;
    SDL_Surface *surface;
    SDL_Color textColor = { 0, 0, 0, 0 };

    surface = TTF_RenderText_Solid(font,text,textColor);
    *texture = SDL_CreateTextureFromSurface(renderer,surface);

    text_width = surface->w;
    text_height = surface->h;

    SDL_FreeSurface(surface);

    rect->x = x;
    rect->y = y;
    rect->w = text_width;
    rect->h = text_height;
}

void lowercase(char string[])
{
    for (int i=0;i<strlen(string);i++)
        string[i] = tolower(string[i]);
}

// Function to create a new student node
data* createStudent(char firstName[], char lastName[], char ID[], char city[])
{
    data* newStudent = (data*)malloc(sizeof(data));
    strcpy(newStudent->firstName, firstName);
    strcpy(newStudent->lastName, lastName);
    strcpy(newStudent->ID, ID);
    strcpy(newStudent->city, city);
    newStudent->prev = NULL;
    newStudent->next = NULL;
    return newStudent;
}

// Function to read the file
data* readFile(data*head,data*tail,data*students[],int *ID_diff)
{
    char firstName[20];
    char lastName[20];
    char ID[20];
    char city[20];
    FILE* file = fopen("students.txt", "r");
    if (file == NULL) 
    {
        printf("Error opening file\n");
    }
    for (int i = 0; i < numStudents; i++) 
    {
        fscanf(file,"%20s%20s%20s%20s",firstName,lastName,ID,city);
        lowercase(firstName);
        lowercase(lastName);
        lowercase(city);
        data* newStudent = createStudent(firstName, lastName, ID, city);

        // Add the student to the linked list
        if (head == NULL) 
        {
            head = newStudent;
            tail = newStudent;
        } else {
            tail->next = newStudent;
            newStudent->prev = tail;
            tail = newStudent;
        }

        // Save the student in the array
        students[i] = newStudent;
        students[i]->row = i+1;
    }
    fclose(file);

    // checking ID
    for (int i=0;i<numStudents;i++)
    {
        for (int j=0;j<numStudents;j++)
        {
            if (i != j)
