    return (head);
}
// Function to save the info from a doubly linked list in an array
void ListToArray(data*head,data*students[])
{
    data * current = head;
    for (int i = 0;i<numStudents;i++)
    {
        current -> row = i+1;
        students[i] = current;
        current = current->next;
    }

}

// Function to save the info from an array to a doubly linked list
data * ArrayToList(data*head,data*students[])
{
    data *head2 = NULL;
    data *tail = NULL;
    for(int i=0;i<numStudents;i++)
    {
        data* newStudent = createStudent(students[i]->firstName, students[i]->lastName, students[i]->ID,students[i]->city);
        newStudent->row = i+1;
        // Add the student to the linked list
        if (head2 == NULL) 
        {
            head2 = newStudent;
            tail = newStudent;
        } else {
            tail->next = newStudent;
            newStudent->prev = tail;
            tail = newStudent;
        }
    }
    return head2;
}

